# 複製成 bridge.env(chmod 600),填好後放在主機上。bridge.env 不要上傳 GitHub(.gitignore 已排除)
# 元大登入
YT_ENV=UAT                      # UAT = 測試環境(先用這個);PROD = 正式環境
YT_ACCOUNT=S98875005091         # 證券:S + 分公司 4 碼 + 帳號 7 碼(這是元大公開的測試帳號)
YT_PASS=1234                    # 電子密碼(測試帳號是 1234)
YT_PFX=/opt/yuanta_bridge/cert/B110000005_TWCA.pfx   # Linux 登入要憑證檔的絕對路徑(測試憑證:元大文件「測試環境」頁下載)
YT_PFX_PASS=yuanta              # 憑證密碼(測試憑證是 yuanta)
YT_SDK_DIR=/opt/yuanta_bridge/sdk   # 元大 SDK 元件包解壓縮的位置(YuantaSparkAPI.dll 和 .so 檔)
# 推到 Cloudflare Worker
WORKER_URL=https://twse-proxy.redwinds542688.workers.dev
PUSH_KEY=                       # 和 Worker 的 YT_PUSH_KEY 密鑰一樣的一串亂碼(自己產生,例如 openssl rand -hex 24)
# 其他
VOL_MULT=1000                   # 元大逐筆成交量的單位是「張」→ × 1000 存成股;第一天用 test 指令確認
TICK_WATCH=60                   # 盤中(09:01~13:24)連續幾秒一筆逐筆都沒收到 → 當作斷線,重新登入、重新訂閱(2026-10-28,10/28 12:07 起斷掉沒發現)
MAX_CODES=200                   # 最多訂閱幾檔(名單照量排序,元大上限 2000)
YT_PMM_CHECK=1                  # 1 = 檢查 PMMServer(元大預設);連線有問題時可改 0 試試
# ── 自動交易(trader.py)── 預設關閉;正式環境還要 TRADE_ALLOW_PROD=1 才會真的下單
TRADE_ENABLE=0                  # 總開關:1 = 程式可以送真單(元三接管、手機強制模式、已有部位平倉)
TRADE_AUTO=0                    # 1 = 照手機判一二三通知自動進場;0 = 不自動進場,只管元三 / 強制模式(2026-10-28 先只開元三)
TRADE_ALLOW_PROD=0              # 正式環境(PROD)下單的總開關,確認測試環境都正常後才改 1
TRADE_QTY=1                     # 每筆張數(TRADE_CAP=0 時才用)
TRADE_CAP=250000                # 2026-10-30 自動進場張數 = 這個金額 ÷ 一張(沒設 = ENGINE_CAP);設 0 = 固定 TRADE_QTY 張
TRADE_MAX_POS=10                # 判一 ~ 四同時最多幾檔部位(2026-10-31 使用者「改 10」;強制進場不佔名額;舊的 2 / 5 程式也當 10)
TRADE_MAX_MOVE_PCT=6.5          # 離昨收對部位不利 ±% → 程式立刻全部平倉(做多 −6.5%、做空 +6.5%;2026-10-28)
TRADE_VERIFY_WAIT=30            # 漲停 / 跌停單送出幾秒沒成交完 → 查元大:還掛著就等,元大沒有這張單就重送(2026-10-28)
TRADE_Y3=1                      # 1 = 在元大(投資先生)自己下的單成交後,程式接過來當「元三」交給判三管(2026-10-28)
TRADE_Y3_TP_PCT=2.5             # 元三的停利 %(跟判三一樣;判三改參數時這裡要一起改)
TRADE_Y3_SL_PCT=4.5             # 元三的停損 %
TRADE_CMD_PIN=                  # 手機強制進場 / 強制平倉的交易密碼;2026-10-29 使用者決定不用密碼:留空 = 不檢查;有設手機就要帶同一組。要 QUOTE_ENABLE=1(通道)
TRADE_MAX_LOSS=20000            # 當天虧損到這個數字就停止進場(2026-10-26 使用者改 20,000,原 3,000)
TRADE_KILL_LOSS=50000           # 當天 已平倉 + 持倉帳面 虧到這個數字就全部平倉、不再自動進場(2026-10-31 使用者「改 5 萬」;0 = 關)
TRADE_JUDGES=判一,判二,判三,判四      # 跟哪些判別式的訊號(2026-10-31 加判四;舊的「判一,判二,判三」trader 也會自動加判四)
TRADE_SLIP_TICKS=2              # 限價讓幾檔確保成交(IOC:沒成交的部分自動取消)
TRADE_MAX_DEV_PCT=0.5           # 現價離訊號價超過 % 就不追
TRADE_FILL_WAIT=8               # 進場送單後等成交回報幾秒,超過就取消剩下的
TRADE_LAST_ENTRY=13:10          # 最後進場時間
TRADE_FORCE_EXIT=13:20          # 強制平倉時間(13:25 起是收盤集合競價,要在那之前平掉;掛漲停 / 跌停 ROD 馬上成交)
TRADE_CANCEL_ALL=1              # 1 = 13:20 先取消全部掛單(委託 + 條件單,含手動的),確認後再平倉
TRADE_RECHECK=13:22,13:23,13:24 # 收盤前確認三次還有沒有未沖銷的股票(查元大成交回報;已掛著的平倉委託會扣掉,不重複下單)
TRADE_RECHECK_CLOSE=all         # 不是程式開的(手動,今天成交的)部位:all = 空單掛漲停買回、多單掛跌停賣出;short = 只平空單(多單只提醒);none = 只提醒
TRADE_BROKER_STOP=0             # 2026-10-28 使用者「所有都不預掛」:0 = 不掛元大條件單,程式盯價碰到停利 / 停損立刻掛漲停 / 跌停平倉;1 = 舊做法(進場後在元大掛二擇一條件單)
TRADE_EXIT_MODE=limitup         # 平倉:limitup = 空單買回掛漲停、多單賣出掛跌停(ROD,保證第一時間成交);slip = 限價讓檔 + IOC
TRADE_TYPE_LONG=0               # 做多的委託種類(0 = 現股 = 元大 App 下單畫面的「現股」;買進和賣出都用這個)
TRADE_TYPE_SHORT=9              # 做空的委託種類(9 = 現股當沖委託控管 = 元大 App 下單畫面的「沖」;空單賣出和買回都用這個)
TRADE_FEE_DISCOUNT=0.25         # 手續費折數(算損益用;2026-10-28 對元大明細是 2.5 折,原 0.3)
TRADE_STOP_FILE=/opt/yuanta_bridge/STOP   # 緊急停止:建立這個檔案(touch)就不再進場,已有部位照樣平倉
# ── 手機即時價走元大(quotes.py)── 預設關閉
QUOTA_PUSH=1                    # 2026-10-29 1 = 每 ~30 秒把「當沖額度剩多少」(總額度 − 今天成交 − 還掛著的委託,含手動)推上 Worker,手機訊息右上角「資金」顯示;0 = 關
TICK_LOG=1                      # 2026-10-30 逐筆原樣記錄(內外盤研究),存 TICK_DIR(預設 ticks_yuanta)\日期.csv;0 = 不記
QUOTA_TOTAL=5000000             # 額度總額(預設跟 TRADE_MAX_AMOUNT 一樣 500 萬;2026-10-31 由 490 萬改)
QUOTA_SEC=60                    # 沒開自動交易時,每幾秒查一次今天委託成交來算額度(查詢類一秒最多 3 次,別低於 30)
QUOTE_ENABLE=0                  # 1 = 開本機報價服務 + 登記 Cloudflare Tunnel,Worker 的 ?codes 先問元大(不通自動回證交所)
AUTO_UPDATE=1                   # 2026-10-30 1 = 中繼啟動時(不在盤中)照 GitHub 的 tools/yuanta_bridge/VERSION 自己更新程式檔再重啟;0 = 手動 win_update.py
ENGINE=0                        # 2026-10-29 1 = 公式在電腦:中繼開工時另開 engine.py,每分鐘用模擬器算判一二三推雲端通知,手機只收不算(要先 pip install pandas numpy)
ENGINE_WORKERS=3                # engine.py 同時跑幾個模擬器行程(電腦核心數的一半左右)
ENGINE_CAP=250000               # 通知裡的張數 = 這個金額 ÷ 一張(和手機的多空上限一樣;中繼下單張數看 TRADE_CAP)
QUOTE_PORT=8787                 # 本機報價服務的埠(只聽 127.0.0.1,對外只經過 cloudflared 通道,要 PUSH_KEY 金鑰才回資料)
CF_METRICS=127.0.0.1:20241      # cloudflared 的 metrics 位址(程式從這裡讀通道網址)
